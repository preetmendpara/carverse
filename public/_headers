/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# HTML had no cache rule at all, so browsers and the edge held old markup
# after a deploy — a phone kept showing the previous header long after the
# new one shipped. Revalidate every time; it is a 304 when nothing changed.
/
  Cache-Control: public, no-cache

/*.html
  Cache-Control: public, no-cache

/app/*
  Cache-Control: public, no-cache

# Code has no content hash in its filename, so a long max-age serves stale
# JS for an hour after every deploy. no-cache still caches — it just
# revalidates first, which is a 304 when nothing changed.
/app/css/*
  Cache-Control: public, no-cache

/app/js/*
  Cache-Control: public, no-cache

/app/assets/*
  Cache-Control: public, max-age=604800

/app/models/*
  Cache-Control: public, max-age=604800

/app/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
