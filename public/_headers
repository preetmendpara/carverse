/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# HTML had no cache rule at all, so browsers and the edge held old markup
# after a deploy — a phone kept showing the previous header long after the
# new one shipped. Revalidate every time; it is a 304 when nothing changed.
/
  Cache-Control: public, no-cache

/*.html
  Cache-Control: public, no-cache

/app/*
  Cache-Control: public, no-cache

# Code has no content hash in its filename, so it cannot be cached forever.
# But plain no-cache made every one of ~18 modules a blocking revalidation
# on every visit — 0 bytes transferred, seconds spent waiting. With
# stale-while-revalidate the browser serves the cached copy immediately and
# refreshes it in the background, so a repeat visit never waits and a deploy
# is picked up on the next navigation.
/app/css/*
  Cache-Control: public, max-age=60, stale-while-revalidate=86400

/app/js/*
  Cache-Control: public, max-age=60, stale-while-revalidate=86400

/app/assets/*
  Cache-Control: public, max-age=604800

/app/models/*
  Cache-Control: public, max-age=604800

/app/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
