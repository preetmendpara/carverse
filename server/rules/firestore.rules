rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && (request.auth.uid == 'U95gwk62Ale4kPfCNSAlUQ7TQcq2'
            || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Admin registry: readable by signed-in users (needed for the guard), writable only server-side/console.
    match /admins/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Public catalogue data — read by anyone, written only by admins.
    match /brands/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /cars/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /carImages/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /carModels/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /specifications/{id} { allow read: if true; allow write: if isAdmin(); }
    match /features/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id}       { allow read: if true; allow write: if isAdmin(); }

    // Each row belongs to one signed-in account: a stranger can neither read
    // nor delete someone else's saved cars.
    match /wishlist/{id} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.carId is string;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
    }
    match /compare/{id} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.carId is string;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
    }

    match /customerInquiries/{id} {
      allow create: if request.auth != null
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 255
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 1000
                    && request.resource.data.status == 'new';
      allow read, update, delete: if isAdmin();
    }

    // AI Car Finder logs, for evaluation. A signed-in buyer may create a log for
    // themselves only; only admins may read or delete; nobody may edit one.
    // hasAll + hasOnly = exactly the eight fields the Worker writes
    // (server/match/log.js, buildMatchLog). expireAt drives a Firestore TTL policy.
    // clickedId is RESERVED and must be null: logs are immutable (no update, by
    // anyone), so it cannot be filled in later. Unused in Phase 1.
    match /matchLogs/{id} {
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(['uid', 'query', 'requirements', 'resultIds', 'clickedId', 'model', 'createdAt', 'expireAt'])
                    && request.resource.data.keys().hasOnly(['uid', 'query', 'requirements', 'resultIds', 'clickedId', 'model', 'createdAt', 'expireAt'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.query is string
                    && request.resource.data.query.size() > 0
                    && request.resource.data.query.size() <= 500
                    && request.resource.data.requirements is map
                    && request.resource.data.resultIds is list
                    && request.resource.data.resultIds.size() <= 3
                    && request.resource.data.clickedId == null
                    && request.resource.data.model is string
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.expireAt is timestamp;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Chatbot transcripts: visitors can log them, only admins can read/manage.
    match /chatHistory/{id} {
      allow create: if request.auth != null
                    && request.resource.data.question is string
                    && request.resource.data.question.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}